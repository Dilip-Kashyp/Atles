# ==========================================
# Core Platform Secrets & Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_USER_ID=

# ==========================================
# MCP Server Paths
# ==========================================
MCP_SERVER_SCRIPT=../mcp-servers/slack/server.py
GITHUB_MCP_SERVER_SCRIPT=../mcp-servers/github/server.py
NOTION_MCP_SERVER_SCRIPT=../mcp-servers/notion/server.py

# ==========================================
# External Integrations Tokens
# ==========================================
GITHUB_TOKEN=
NOTION_TOKEN=

# ==========================================
# Memory System (MongoDB)
# ==========================================
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB_NAME=ai_teammate
MEMORY_ENABLED=true
